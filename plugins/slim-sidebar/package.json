{
  "name": "bb-plugin-slim-sidebar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Slim sidebar",
    "description": "Collapses bb's sidebar into a thin icon rail under a full-width top bar, as one seamless frame: icon-only navigation with tooltips and the footer stacked vertically. Pairs with History keys and Minimal top bar.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "bb-motion": "file:../motion/lib"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "bb-motion": "link:../motion/lib"
    }
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
