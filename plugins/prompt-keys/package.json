    "bb-vim-keys": "file:../vim-mode/lib"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
