{
  "name": "bb-plugin-settings-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Settings search",
    "description": "A search bar at the top of the settings sidebar that finds any setting on any settings page, plugin pages included, and takes you to it.",
    "branding": {
      "icon": "Search"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "bb-motion": "file:../motion/lib"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "bb-motion": "link:../motion/lib"
    }
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
