{
  "name": "bb-plugin-settings-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Settings search",
    "description": "Vim keys for settings: j/k walk the sidebar's pages and the open page's settings, and bb's settings search gets Ctrl-n/p and puts the cursor on the setting it opens.",
    "branding": {
      "icon": "Search"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "bb-motion": "file:../motion/lib",
    "bb-vim-keys": "file:../vim-mode/lib"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
